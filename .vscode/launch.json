    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Backend API",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/api.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Frontend in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/frontend",
            "preLaunchTask": "Serve Frontend"
        }
    ],
    "compounds": [
        {
            "name": "Run Full App",
            "configurations": ["Launch Backend API", "Launch Frontend in Chrome"]
        }
    ]
}