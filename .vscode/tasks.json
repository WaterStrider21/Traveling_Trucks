{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Frontend",
            "type": "shell",
            "command": "python -m http.server 8080",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*"
                }
            }
        }
    ]
}
